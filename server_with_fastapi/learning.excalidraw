      "versionNonce": 1813766733,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790069516504,
      "link": null,
      "locked": false,
      "text": "1.uv init .\n2.uv add fastmcp \n\n3.uv run fastmcp version\n  \n   write the code to generate mcp server  \n   we created expense tracker fast api\n   using this api we convert into mcp server\n  \n\n  \n\n4.uv run fastmcp dev inspector main.py\n\n5.uv run fastmcp install claude-desktop main.py",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.uv init .\n2.uv add fastmcp \n\n3.uv run fastmcp version\n  \n   write the code to generate mcp server  \n   we created expense tracker fast api\n   using this api we convert into mcp server\n  \n\n  \n\n4.uv run fastmcp dev inspector main.py\n\n5.uv run fastmcp install claude-desktop main.py",
      "autoResize": true,
      "lineHeight": 1.35
    },
